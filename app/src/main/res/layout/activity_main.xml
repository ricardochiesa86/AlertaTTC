<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    tools:context=".MainActivity">

    <!-- Medidores: fps e latencia, topo -->
    <LinearLayout
        android:id="@+id/rowMetrics"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="24dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/lblFps"
                style="@style/MetricLabel"
                android:text="@string/label_fps" />
            <TextView
                android:id="@+id/tvFps"
                style="@style/MetricValue"
                tools:text="12.3" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/lblLatency"
                style="@style/MetricLabel"
                android:text="@string/label_latency" />
            <TextView
                android:id="@+id/tvLatency"
                style="@style/MetricValue"
                tools:text="87 ms" />
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="12dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:fontFamily="monospace"
        tools:text="GPU delegate ativo * corte 0.62"
        app:layout_constraintTop_toBottomOf="@id/rowMetrics"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Ver camera (diagnostico) + Recalibrar + Ajustes -->
    <LinearLayout
        android:id="@+id/rowControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTogglePreview"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:paddingHorizontal="4dp"
            android:textSize="11sp"
            android:text="@string/btn_show_camera" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRecalibrate"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="6dp"
            android:paddingHorizontal="4dp"
            android:textSize="11sp"
            android:text="@string/btn_recalibrate" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettings"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:paddingHorizontal="4dp"
            android:textSize="11sp"
            android:text="@string/btn_settings" />

    </LinearLayout>

    <!-- Preview de diagnostico: mesmo bitmap que o detector analisou, com
         caixas/linhas desenhadas por cima. Desligado por padrao. -->
    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="0dp"
        android:layout_height="260dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="12dp"
        android:background="@color/surface"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/rowControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.alertattc.app.ui.DetectionOverlayView
            android:id="@+id/detectionOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- TTC -->
    <TextView
        android:id="@+id/lblTtc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/label_ttc"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:letterSpacing="0.2"
        app:layout_constraintTop_toBottomOf="@id/previewContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvTtc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttc_placeholder"
        android:textColor="@color/text_primary"
        android:textSize="72sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-condensed"
        app:layout_constraintTop_toBottomOf="@id/lblTtc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvAlert"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/alert_text"
        android:textColor="@color/accent_alert"
        android:textSize="34sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:visibility="invisible"
        app:layout_constraintTop_toBottomOf="@id/tvTtc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnStop"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="32dp"
        android:text="@string/btn_stop"
        android:backgroundTint="@color/surface"
        android:textColor="@color/text_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Overlay de borda vermelha em alerta, por cima de tudo -->
    <View
        android:id="@+id/overlayBorder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/alert_border"
        android:visibility="invisible" />

</androidx.constraintlayout.widget.ConstraintLayout>
