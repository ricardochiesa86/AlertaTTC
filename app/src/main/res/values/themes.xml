<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AlertaTTC" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="colorPrimary">@color/accent_ok</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/accent_warn</item>
    </style>

    <style name="MetricLabel">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="MetricValue">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
